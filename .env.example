# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: Optional comma-separated allowlist for cross-origin API requests.
ALLOWED_ORIGINS=""

# PERFORMANCE, CDN & SCALING CONFIGURATION
# Optional CDN origin URL for public assets & non-private uploads (leave blank for direct origin delivery)
CDN_BASE_URL=""
VITE_CDN_URL=""
# SQLite WAL read connection pool size (1-8 concurrent read handles)
DB_READ_POOL_SIZE="4"
# Reverse proxy / load balancer worker count hint
CLUSTER_WORKERS="1"

# ADMIN & MODERATOR AUTHENTICATION SECRETS
# Set strong passwords via server environment secrets for @THEBACKDOOR and @campus_mod.
# Never commit actual secret values to version control or expose them in client code.
ADMIN_PASSWORD=""
MODERATOR_PASSWORD=""

# SESSION LIFECYCLE & MULTI-DEVICE LIMITS
# Short-lived access token lifetime in minutes (default 15), sliding refresh window in days (30),
# maximum absolute session lifetime in days (90), and maximum concurrent devices per account (5).
ACCESS_TOKEN_TTL_MINUTES="15"
REFRESH_SESSION_DAYS="30"
SESSION_MAX_LIFETIME_DAYS="90"
MAX_ACTIVE_DEVICES="5"
REAUTH_WINDOW_MINUTES="15"

# BOT PROTECTION (Privacy-Preserving Proof-of-Work Challenge)
# Leading zero bits required on registration SHA-256 PoW challenge (default 14, range 8-20).
BOT_POW_DIFFICULTY="14"

# WEBAUTHN / PASSKEYS (Stage 3C)
# RP ID must match your production domain (e.g. "schoolbackdoor.app") or "localhost" for local dev.
# WEBAUTHN_ORIGINS is a comma-separated list of full origins (e.g. "https://schoolbackdoor.app,https://www.schoolbackdoor.app").
# Localhost origins are automatically allowed only when NODE_ENV !== "production".
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="Schoolbackdoor"
WEBAUTHN_ORIGINS="http://localhost:3000"
